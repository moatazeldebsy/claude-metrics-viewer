# mock (default) or anthropic
DATA_SOURCE=mock
# Required when DATA_SOURCE=anthropic. Admin API key from the Claude Console (sk-ant-admin...)
ANTHROPIC_ADMIN_KEY=
# Optional: CSV of email,department for the Departments tab and filter (real data only)
DEPARTMENTS_FILE=
# Country for 'Exclude holidays' (ISO code, optionally with state: US, DE, GB, US-CA). Default US.
HOLIDAY_COUNTRY=US
