{
  "name": "@moatazeldebsy/claude-metrics-lib",
  "version": "0.1.0",
  "description": "Claude Metrics data layer: Anthropic Admin API and mock sources, aggregation, departments, holidays. Shared by the Nuxt app and the Backstage plugins.",
  "license": "MIT",
  "author": "Moataz Nabil",
  "homepage": "https://github.com/moatazeldebsy/claude-metrics-viewer/tree/main/backstage#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moatazeldebsy/claude-metrics-viewer.git",
    "directory": "backstage/packages/claude-metrics-lib"
  },
  "bugs": {
    "url": "https://github.com/moatazeldebsy/claude-metrics-viewer/issues"
  },
  "keywords": [
    "backstage",
    "backstage-plugin",
    "claude",
    "claude-code",
    "anthropic",
    "admin-api"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "server": [
        "src/server.ts"
      ],
      "package.json": [
        "package.json"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "backstage": {
    "role": "common-library"
  },
  "sideEffects": false,
  "scripts": {
    "build": "backstage-cli package build",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.5.0",
    "date-holidays": "3.39.2"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.7"
  },
  "files": [
    "dist"
  ]
}
