# mock (default), anthropic (Admin API) or otel (Claude Code OpenTelemetry, see docs/opentelemetry.md)
DATA_SOURCE=mock
# Required when DATA_SOURCE=anthropic. Admin API key from the Claude Console (sk-ant-admin...)
ANTHROPIC_ADMIN_KEY=
# Optional: CSV of email,department for the Departments tab and filter (real data only)
DEPARTMENTS_FILE=
# Country for 'Exclude holidays' (ISO code, optionally with state: US, DE, GB, US-CA). Default US.
HOLIDAY_COUNTRY=US
# DATA_SOURCE=otel: comma-separated bearer tokens Claude Code sends (OTEL_EXPORTER_OTLP_HEADERS). Ingest is off without one.
OTEL_INGEST_TOKENS=
# DATA_SOURCE=otel: SQLite file for the daily totals. Default ./.data/telemetry.db
TELEMETRY_DB=
# DATA_SOURCE=otel: days of totals to keep; 0 keeps everything. Default 400.
TELEMETRY_RETENTION_DAYS=400
